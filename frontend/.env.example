# 前端环境变量（复制为 .env 后填入实际值）
VITE_API_BASE=http://localhost:8000

# LiveKit 配置（从 cloud.livekit.io 获取）
VITE_LIVEKIT_URL=wss://your-project.cloud.livekit.livekit.cloud
VITE_LIVEKIT_API_KEY=your_api_key
VITE_LIVEKIT_API_SECRET=your_api_secret

# AI API Keys（可选，AI 处理也可在浏览器端直接运行）
VITE_DEEPGRAM_KEY=your_deepgram_key
VITE_DEEPL_KEY=your_deepl_key
VITE_ELEVENLABS_KEY=your_elevenlabs_key
