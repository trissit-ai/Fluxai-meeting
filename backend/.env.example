# ============ LiveKit ============
# 注册 https://cloud.livekit.io 创建项目获取
LIVEKIT_URL=wss://your-project.cloud.livekit.livekit.cloud
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret

# ============ AI API Keys ============
# Deepgram: https://console.deepgram.com/register (免费 200 分钟)
DEEPGRAM_API_KEY=your_deepgram_key

# DeepL: https://www.deepl.com/pro-api (免费账号有有限额度)
DEEPL_API_KEY=your_deepl_key

# ElevenLabs: https://elevenlabs.io (免费账号有分钟数)
ELEVENLABS_API_KEY=your_elevenlabs_key

# ============ Server ============
HOST=0.0.0.0
PORT=8000
JWT_SECRET=change_this_to_random_string_at_least_32_chars
